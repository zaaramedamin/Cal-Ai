# CalAi environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored. This file is committed and must never contain a real
# secret — it exists so anyone cloning the repo knows exactly what to set.

# ---- Postgres (consumed by docker-compose.yml) ------------------------------
POSTGRES_USER=calai
POSTGRES_PASSWORD=calai_dev_password
POSTGRES_DB=calai
POSTGRES_PORT=5432

# ---- Backend ----------------------------------------------------------------
# The +asyncpg driver is required: SQLAlchemy 2.0 async needs an async driver.
# A plain postgresql:// URL here will fail at startup, on purpose, rather than
# silently blocking the event loop with a sync driver.
#
# Use 127.0.0.1, NOT localhost. On Windows, `localhost` resolves to the IPv6
# address ::1 first, but docker-compose publishes the port on IPv4 only — so
# every new connection waits for the IPv6 attempt to fail before retrying.
# Measured on this project: 2123 ms per connection via localhost, 84 ms via
# 127.0.0.1. A 25x difference that looks like "Postgres is slow" and is not.
DATABASE_URL=postgresql+asyncpg://calai:calai_dev_password@127.0.0.1:5432/calai

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Phase 1: auth ----------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing this invalidates every issued token, which is the intended panic button.
# The app refuses to start on this placeholder value, on purpose: shipping with
# it would let anyone who has read the repo forge a token for any account.
SECRET_KEY=replace-me-with-a-64-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Rate limiting -----------------------------------------------------------
# Counters live in the memory of one process, so two workers each keep their own
# tally. Fine for a single-process deployment; move to Redis before scaling out.
RATE_LIMIT_ENABLED=true

# Only enable behind a proxy that overwrites X-Forwarded-For (Railway, Fly, a
# properly configured nginx). Trusting the header without one lets any client
# forge its address and bypass every per-IP limit.
TRUST_PROXY_HEADERS=false

# ---- Phase 3: nutrition data sources ----------------------------------------
# Free key from https://fdc.nal.usda.gov/api-key-signup.html
# Limit: 1,000 requests/hour. DEMO_KEY is 30/hour and 50/day — fine to smoke
# test with, useless for real development.
USDA_API_KEY=DEMO_KEY

# Open Food Facts requires a descriptive User-Agent or it will rate-limit and
# eventually ban you. Format: AppName/Version (contact email)
# Limits are severe: 15 req/min for product reads, 10 req/min for search.
OFF_USER_AGENT=CalAi/0.1 (aminezaara67@gmail.com)

# ---- AI meal photo scanning --------------------------------------------------
# Free key from https://aistudio.google.com/apikey — no credit card, ~250
# requests/day on the free tier. Leave blank to disable photo scanning: the app
# still runs and the /scan endpoint answers 503 explaining how to enable it.
#
# The model only identifies foods and estimates portion sizes. Every calorie and
# macro still comes from USDA, so nothing here can introduce an invented value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
